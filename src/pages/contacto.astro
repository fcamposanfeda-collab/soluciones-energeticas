---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { getPageMeta } from '../data/pages-meta';
import { contact } from '../data/site';
---

<BaseLayout title={getPageMeta('/contacto').title} description={getPageMeta('/contacto').description}>
  <PageHeader title="Contacto" subtitle="Consulta sobre CAEs, bonos de carbono y soluciones energéticas" />
  <section class="section contact-page">
    <div class="container contact-page__grid">
      <aside class="contact-page__info">
        <h2>Hablemos</h2>
        <p>Escríbenos tu consulta o llámanos directamente.</p>
        <p><strong>Email</strong><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p><strong>Teléfono</strong><br /><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></p>
      </aside>
      <div class="contact-page__form">
        <ContactForm formId="contact-page" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page__grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-page__info h2 {
    margin: 0 0 0.75rem;
    color: var(--color-secondary);
  }

  .contact-page__info p {
    margin: 0 0 1rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .contact-page__info a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .contact-page__form {
    padding: 1.75rem;
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  @media (min-width: 768px) {
    .contact-page__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

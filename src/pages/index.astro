---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import Button from '../components/ui/Button.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import PartnerSection from '../components/sections/PartnerSection.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import { services } from '../data/services';

const meta = getPageMeta('/');
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="hero section">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Soluciones climáticas y energéticas</p>
      <h1 class="hero__title">
        <span>Gestionamos y compramos</span>
      </h1>
      <ul class="hero__pills" aria-label="Áreas de actividad">
        {
          services.map((s) => (
            <li><a href={s.href}>{s.shortTitle}</a></li>
          ))
        }
      </ul>
      <p class="hero__lead">
        Especialistas en CAEs, bonos de carbono, huella hídrica e hidrógeno verde. Partner B2B para
        empresas que quieren ofrecer valor añadido a sus clientes sin cargar con la gestión administrativa.
      </p>
      <div class="hero__actions">
        <Button href="/contacto" variant="primary">Consulta</Button>
        <Button href="/que-es-un-cae" variant="ghost">Qué es un CAE</Button>
      </div>
    </div>
  </section>

  <ServicesGrid />
  <PartnerSection />
  <ContactCta />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-on-primary);
    min-height: clamp(28rem, 75vh, 36rem);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    max-width: 44rem;
  }

  .hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-on-primary);
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }

  .hero__pills a {
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    color: var(--color-on-primary);
  }

  .hero__pills a:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .hero__lead {
    margin: 0 0 2rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

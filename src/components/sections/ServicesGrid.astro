---
import Button from '../ui/Button.astro';
import { services } from '../../data/services';
---

<section class="services-grid section" aria-labelledby="services-title">
  <div class="container">
    <header class="services-grid__header">
      <h2 id="services-title">Nuestros servicios</h2>
      <p>Gestionamos y compramos soluciones energéticas y climáticas para empresas y partners del sector.</p>
    </header>
    <div class="services-grid__cards">
      {
        services.map((service) => (
          <article class="service-card">
            <h3>{service.shortTitle}</h3>
            <p>{service.description}</p>
            <a href={service.href} class="service-card__link">Saber más →</a>
          </article>
        ))
      }
    </div>
    <div class="services-grid__cta">
      <Button href="/servicios" variant="outline">Ver todos los servicios</Button>
      <Button href="/contacto" variant="primary">Consulta</Button>
    </div>
  </div>
</section>

<style>
  .services-grid__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .services-grid__header h2 {
    margin: 0 0 0.75rem;
    color: var(--color-secondary);
  }

  .services-grid__header p {
    margin: 0;
    color: var(--color-muted);
  }

  .services-grid__cards {
    display: grid;
    gap: 1.25rem;
  }

  .service-card {
    padding: 1.5rem;
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .service-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    color: var(--color-primary-dark);
  }

  .service-card p {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .service-card__link {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-primary);
  }

  .services-grid__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .services-grid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

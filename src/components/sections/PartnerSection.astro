---
import Button from '../ui/Button.astro';
import { partnerPitch, partnerBenefits } from '../../data/services';
---

<section class="partner section" aria-labelledby="partner-title">
  <div class="container partner__inner">
    <h2 id="partner-title">Partner para constructoras, instaladores e ingenierías</h2>
    <p>{partnerPitch}</p>
    <ul class="partner__list">
      {partnerBenefits.map((item) => <li>{item}</li>)}
    </ul>
    <div class="partner__actions">
      <Button href="/contacto" variant="primary">Hablemos de colaboración</Button>
      <Button href="/servicios#cae" variant="outline">Ver servicio CAE</Button>
    </div>
  </div>
</section>

<style>
  .partner {
    background: var(--color-bg-muted);
    border-block: 1px solid var(--color-border);
  }

  .partner__inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .partner h2 {
    margin: 0 0 1rem;
    color: var(--color-secondary);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
  }

  .partner p {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .partner__list {
    margin: 0 auto 1.75rem;
    padding: 0;
    list-style: none;
    text-align: left;
    max-width: 36rem;
  }

  .partner__list li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.65rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .partner__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .partner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>

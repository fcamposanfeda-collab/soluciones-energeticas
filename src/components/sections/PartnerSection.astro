---
import Button from '../ui/Button.astro';
import { partnerPitch } from '../../data/services';
---

<section class="partner section" aria-labelledby="partner-title">
  <div class="container partner__inner">
    <h2 id="partner-title">Partner para empresas de construcción y eficiencia energética</h2>
    <p>{partnerPitch}</p>
    <p>
      Al mismo tiempo, facilitas a tus clientes la tramitación de los Certificados de Ahorro Energético,
      mejorando su experiencia y satisfacción.
    </p>
    <Button href="/contacto" variant="primary">Hablemos de colaboración</Button>
  </div>
</section>

<style>
  .partner {
    background: var(--color-bg-muted);
    border-block: 1px solid var(--color-border);
  }

  .partner__inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .partner h2 {
    margin: 0 0 1rem;
    color: var(--color-secondary);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
  }

  .partner p {
    margin: 0 0 1rem;
    color: var(--color-muted);
    line-height: 1.75;
  }
</style>
